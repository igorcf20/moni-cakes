# Só para desenvolvimento local (o VPS não usa este ficheiro: o deploy/sync.sh gera os valores).
# Copie para .env. São valores PÚBLICOS (papel anon, protegido por RLS); a SERVICE_ROLE_KEY nunca vem para aqui.
#
# Backend: a stack local do deploy/local-up.sh (http://127.0.0.1:18190). O servidor do Vite encaminha
# /rest/v1, /auth/v1, /storage/v1 e /functions/v1 para LOJA3D_BACKEND_URL.
# VITE_SUPABASE_PUBLISHABLE_KEY = ANON_KEY do ficheiro env que o local-up.sh indica.
VITE_SUPABASE_PUBLISHABLE_KEY=
# Vazio = o site usa a própria origem como endereço da API (é o que acontece no VPS).
VITE_SUPABASE_URL=
# Endereço público da loja para links de e-mail (vazio = endereço aberto no navegador).
VITE_SITE_URL=
LOJA3D_BACKEND_URL=http://127.0.0.1:18190
VITE_ENABLE_PRODUCT_3D_PREVIEW=false
