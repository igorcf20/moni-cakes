# Moni Cakes: variáveis do servidor, em ~/monicakes/env no VPS (chmod 600). Nunca colocar no Git nem no chat.
# Tudo corre no próprio VPS (deploy/compose.yaml): PostgreSQL, login, ficheiros e funções. Sem conta externa.
#
# SEGREDOS: gerados automaticamente no VPS por deploy/gen-secrets.sh (o bootstrap.sh e o sync.sh chamam-no).
# Não os escreva à mão. Ficam neste ficheiro com estes nomes:
#   POSTGRES_PASSWORD  palavra-passe da base. NÃO mudar depois do 1.º arranque (a base guarda a antiga).
#   JWT_SECRET         assina as sessões e as chaves. Mudar termina todas as sessões (as chaves são refeitas).
#   ANON_KEY           chave pública do site (papel anon); entra no código do site.
#   SERVICE_ROLE_KEY   chave de serviço; só no servidor, nunca no site.
#   CRON_SECRET        pedidos agendados da base às funções (cabeçalho x-cron-secret).
# Depois de mudar qualquer valor deste ficheiro: bash ~/monicakes/sync.sh force

# Endereço público da loja, sem barra no fim (ex.: https://www.dominio.com.br). Usado nos links dos e-mails,
# nos redirecionamentos do login e pelas funções. Vazio enquanto não houver domínio (usa http://127.0.0.1:8191).
SITE_URL=

# Porta local do site e da API (o nginx do servidor encaminha o domínio para aqui).
# Confirmar que está livre: ss -ltn | grep 8191
LOJA3D_HTTP_PORT=8191

# Outros destinos aceites depois do login, além do domínio de SITE_URL (opcional, separados por vírgula).
# Ex.: https://outro-dominio.com/**
ADDITIONAL_REDIRECT_URLS=

# E-mail (SMTP), opcional. Sem SMTP_HOST, as contas ficam ativas logo no registo e não é enviado nenhum
# e-mail (nem o de recuperação de palavra-passe). Com SMTP_HOST, o registo passa a pedir confirmação por e-mail.
SMTP_HOST=
SMTP_PORT=587
SMTP_USER=
SMTP_PASS=
# Remetente dos e-mails (ex.: nao-responda@dominio.com.br) e nome mostrado.
SMTP_ADMIN_EMAIL=
SMTP_SENDER_NAME=
# Entrar com Google / Facebook (opcional). Crie as credenciais na Google Cloud (OAuth, aplicação Web) ou na
# Meta for Developers, com o endereço de retorno <SITE_URL>/auth/v1/callback. Depois de preencher, ligue o
# recurso "Entrar com Google ou Facebook" em Admin > Recursos da loja. Guia: Admin > Segurança da conta.
GOOGLE_LOGIN_ENABLED=false
GOOGLE_CLIENT_ID=
GOOGLE_CLIENT_SECRET=
FACEBOOK_LOGIN_ENABLED=false
FACEBOOK_APP_ID=
FACEBOOK_APP_SECRET=
# Forçar o registo: true (sem confirmação) ou false (com confirmação). Vazio = automático pelo SMTP_HOST.
ENABLE_EMAIL_AUTOCONFIRM=

# Integrações (opcionais). As credenciais de pagamento, frete e faturação entram pelo painel Admin, não aqui.
# Segredo do pedido horário do pg_cron à função ctt-track (cabeçalho x-cron-secret).
# Gerado pelo gen-secrets.sh como os outros segredos (fica neste ficheiro com o nome CRON_SECRET).
# true = o viva-webhook só aceita pedidos dos IPs da Viva.
VIVA_WEBHOOK_STRICT_IP=

# Cópias de segurança DIÁRIAS (deploy/backup.sh, timer monicakes-backup.timer entre as 03:30 e as 04:30 de Brasília):
# base de dados (loja3d-diaria-AAAAMMDD-HHMMSS.dump) e ficheiros enviados, como fotos, comprovativos e modelos 3D
# (loja3d-ficheiros-AAAAMMDD-HHMMSS.tar.gz), na pasta LOJA3D_BACKUP_DIR. Restaurar: deploy/restore.sh --listar.
# Destino fora do VPS (opcional, recomendado): as duas cópias novas de cada dia são enviadas para lá com rsync por
# SSH (ou scp, se não houver rsync), sempre sem palavra-passe: chave SSH do utilizador administrator, sem perguntas.
# Formato [utilizador@]servidor:/pasta/ ; o mais simples é um Host do ~/.ssh/config, ex.:
#   LOJA3D_BACKUP_REMOTE=copias-loja3d:/srv/copias/loja3d/
# Ou um disco montado neste servidor (a pasta tem de existir): LOJA3D_BACKUP_REMOTE=/mnt/copias/loja3d/
# Só letras, números e . _ - / + = (sem espaços, ~ nem aspas); outro formato é recusado e nada é enviado.
# Antes da 1.ª cópia, ligar uma vez à mão (ssh copias-loja3d) para aceitar a chave do servidor: sem perguntas, um
# servidor desconhecido é recusado. Vazio = as cópias ficam só neste VPS (o resumo de cada cópia lembra isso).
# As cópias antigas no destino não são apagadas por este script (a retenção lá fica com quem gere esse servidor).
LOJA3D_BACKUP_REMOTE=

# Avançado (opcional; os valores indicados são os de omissão).
# Pasta das cópias de segurança: as diárias e as feitas antes de cada migration nova.
# LOJA3D_BACKUP_DIR=/home/administrator/loja3d/backups
# Quantas cópias de antes das migrations guardar (as diárias têm a retenção a seguir).
# BACKUP_KEEP=10
# Retenção das cópias diárias (base e ficheiros, cada tipo à parte): as N mais recentes, mais a mais recente de cada
# uma das últimas M semanas já terminadas (de segunda a domingo; normalmente a de domingo). A cópia mais recente
# nunca é apagada. Com 7 + 4: cerca de 4 semanas de histórico, com 10 ou 11 cópias de cada tipo.
# LOJA3D_BACKUP_KEEP_DAILY=7
# LOJA3D_BACKUP_KEEP_WEEKLY=4
# Espaço livre mínimo em MB no disco das cópias. Abaixo disso a cópia não começa (ou salta a parte que o deixaria
# abaixo do mínimo) e o serviço fica com erro: protege a base de dados, que usa o mesmo disco.
# LOJA3D_BACKUP_MIN_FREE_MB=2048
# Segundos que a cópia diária espera por um deploy (sync.sh) ou restauro a decorrer antes de desistir.
# LOJA3D_BACKUP_LOCK_WAIT=2700
# off = o sync.sh deixa de ligar sozinho o timer das cópias diárias (para as parar: definir off e depois
# systemctl --user disable --now monicakes-backup.timer). Vazio = ligado.
# LOJA3D_BACKUP_TIMER=
# Tamanho máximo de cada ficheiro enviado, em bytes (50 MB).
# STORAGE_FILE_SIZE_LIMIT=52428800
# Duração do token de sessão em segundos (renovado sozinho).
# JWT_EXPIRY=3600
# Limite de e-mails do login por hora (todo o site).
# AUTH_RATE_LIMIT_EMAIL_SENT=30
